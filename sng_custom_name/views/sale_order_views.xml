<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Tree View to add Commercial Name column -->
    <record id="view_order_tree_inherit_commercial_name" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.commercial.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_commercial_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sale Order Quotation Tree View to add Commercial Name column -->
    <record id="view_quotation_tree_inherit_commercial_name" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.inherit.commercial.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_commercial_name" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit base Sale Order Search View (covers both quotations and orders) -->
    <record id="view_sales_order_filter_inherit_commercial_name" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.commercial.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_commercial_name" string="Nombre Comercial"
                       filter_domain="[('partner_commercial_name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
