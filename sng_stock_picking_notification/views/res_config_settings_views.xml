<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_sng_stock_notification" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sng.stock.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Notificaciones de Stock" name="sng_stock_picking_notification_block">
                    <setting id="stock_notification_users" string="Usuarios a notificar por falta de stock"
                             help="Seleccione los usuarios que recibirán notificación por chat y correo cuando una entrega no pueda validarse por falta de stock.">
                        <field name="stock_notification_user_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
