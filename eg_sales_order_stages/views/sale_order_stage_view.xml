<odoo>
    <!-- Stage model form & list -->
    <record id="view_sale_order_stage_list" model="ir.ui.view">
        <field name="name">sale.order.stage.list</field>
        <field name="model">sale.order.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="show_in_kanban"/>
            </list>
        </field>
    </record>
    <record id="view_sale_order_stage_form" model="ir.ui.view">
        <field name="name">sale.order.stage.form</field>
        <field name="model">sale.order.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="show_in_kanban"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_stage_action" model="ir.actions.act_window">
        <field name="name">Sales Stages</field>
        <field name="res_model">sale.order.stage</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sale_order_stage_sale_menu"
              name="Sale Stages"
              action="eg_sales_order_stages.sale_order_stage_action"
              parent="sale.menu_sales_config"
              sequence="30"/>

</odoo>
