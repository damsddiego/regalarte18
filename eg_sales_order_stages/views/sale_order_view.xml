<odoo>

    <!-- Add stage field to sale order form -->
    <record id="view_order_form_inherit_stage" model="ir.ui.view">
        <field name="name">sale.order.form.stage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <header>
                    <field name="sale_order_stages" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

            </xpath>
        </field>
    </record>

    <record id="view_order_graph_inherit_stage" model="ir.ui.view">
        <field name="name">sale.order.graph.stage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//graph" position="inside">
                <field name="sale_order_stages"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_list_inherit_stage" model="ir.ui.view">
        <field name="name">sale.order.list.stage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state']" position="after">
                <field name="sale_order_stages" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_search_inherit_stage" model="ir.ui.view">
        <field name="name">sale.order.search.stage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Stage" name="sale_stage" domain="[]" context="{'group_by':'sale_order_stages'}"/>
            </xpath>
        </field>
    </record>
</odoo>
