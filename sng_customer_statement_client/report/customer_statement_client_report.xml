<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_customer_statement_client" model="report.paperformat">
        <field name="name">Estado de Cuenta para Cliente</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_customer_statement_client_html" model="ir.actions.report">
        <field name="name">Vista previa - Estado de Cuenta de Clientes</field>
        <field name="model">sng.customer.statement.client.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">sng_customer_statement_client.report_customer_statement_client</field>
        <field name="report_file">sng_customer_statement_client.report_customer_statement_client</field>
        <field name="paperformat_id" ref="paperformat_customer_statement_client"/>
        <field name="groups_id" eval="[(4, ref('sng_customer_statement.group_customer_statement_user'))]"/>
    </record>

    <record id="action_report_customer_statement_client_pdf" model="ir.actions.report">
        <field name="name">Estado de Cuenta de Clientes</field>
        <field name="model">sng.customer.statement.client.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sng_customer_statement_client.report_customer_statement_client</field>
        <field name="report_file">sng_customer_statement_client.report_customer_statement_client</field>
        <field name="print_report_name">'Estado_Cuenta_%s_%s' % (object.partner_id.name.replace(' ', '_'), object.statement_date)</field>
        <field name="paperformat_id" ref="paperformat_customer_statement_client"/>
        <field name="groups_id" eval="[(4, ref('sng_customer_statement.group_customer_statement_user'))]"/>
    </record>
</odoo>
