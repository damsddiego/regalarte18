<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_statement_client_wizard_form" model="ir.ui.view">
        <field name="name">sng.customer.statement.client.wizard.form</field>
        <field name="model">sng.customer.statement.client.wizard</field>
        <field name="arch" type="xml">
            <form string="Estado de Cuenta de Clientes">
                <div class="alert alert-info" role="alert">
                    <strong>Documento individual para enviar al cliente.</strong>
                    Los saldos en colones y dólares se muestran por separado y nunca se suman entre sí.
                </div>
                <group>
                    <group string="Cliente">
                        <field name="partner_id"
                               options="{'no_create': True}"
                               placeholder="Seleccione un cliente..."/>
                        <field name="company_id"
                               options="{'no_create': True}"
                               groups="base.group_multi_company"/>
                    </group>
                    <group string="Opciones">
                        <field name="statement_date" readonly="1"/>
                        <field name="show_draft_payments"/>
                        <field name="show_bank_accounts"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert">
                    Este reporte muestra saldos abiertos actuales. Los pagos recibidos pendientes de
                    confirmación se presentan por separado y no reducen el saldo.
                </div>
                <footer>
                    <button name="action_preview_html"
                            string="Vista previa"
                            type="object"
                            class="btn-primary"
                            icon="fa-eye"/>
                    <button name="action_print_pdf"
                            string="Descargar PDF"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_statement_client_wizard" model="ir.actions.act_window">
        <field name="name">Estado de Cuenta de Clientes</field>
        <field name="res_model">sng.customer.statement.client.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_customer_statement_client_wizard_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('sng_customer_statement.group_customer_statement_user'))]"/>
    </record>
</odoo>
