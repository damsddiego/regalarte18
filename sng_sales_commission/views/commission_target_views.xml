<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_commission_target_list" model="ir.ui.view">
        <field name="name">sng.commission.target.list</field>
        <field name="model">sng.commission.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="salesperson_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="target_amount"/>
            </list>
        </field>
    </record>

    <record id="view_sng_commission_target_form" model="ir.ui.view">
        <field name="name">sng.commission.target.form</field>
        <field name="model">sng.commission.target</field>
        <field name="arch" type="xml">
            <form string="Meta mensual">
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="salesperson_id"/>
                            <field name="target_amount"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sng_commission_target_search" model="ir.ui.view">
        <field name="name">sng.commission.target.search</field>
        <field name="model">sng.commission.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_id"/>
                <field name="salesperson_id"/>
                <field name="year"/>
                <field name="month"/>
            </search>
        </field>
    </record>

    <record id="action_sng_commission_target" model="ir.actions.act_window">
        <field name="name">Metas mensuales</field>
        <field name="res_model">sng.commission.target</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
