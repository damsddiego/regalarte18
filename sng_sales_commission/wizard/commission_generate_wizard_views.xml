<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_commission_generate_wizard_form" model="ir.ui.view">
        <field name="name">sng.commission.generate.wizard.form</field>
        <field name="model">sng.commission.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar liquidaciones">
                <group>
                    <group>
                        <field name="plan_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="year"/>
                        <field name="month"/>
                    </group>
                </group>
                <group>
                    <field name="salesperson_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_commission_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generar liquidaciones</field>
        <field name="res_model">sng.commission.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
