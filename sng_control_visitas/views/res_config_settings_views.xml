<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_control_visitas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sng.control.visitas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="after">
                <block title="Control de visitas y televentas" name="sng_control_visitas_setting_container">
                    <setting string="Responsable de televentas"
                             help="Usuario al que se asignan los seguimientos de televentas y sus actividades.">
                        <field name="sng_televentas_user_id"/>
                    </setting>
                    <setting string="Días sin facturar para alerta"
                             help="Umbral de la alerta gerencial 'Más de N días sin facturar'.">
                        <field name="sng_control_visitas_dias_alerta_factura"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
