<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_sales_route_form_control" model="ir.ui.view">
        <field name="name">sng.sales.route.form.control.visitas</field>
        <field name="model">sng.sales.route</field>
        <field name="inherit_id" ref="sng_sales_routes.view_sng_sales_route_form"/>
        <field name="arch" type="xml">
            <field name="salesperson_id" position="after">
                <field name="sng_tipo_atencion"/>
                <field name="sng_frecuencia_visita"/>
            </field>
        </field>
    </record>

    <record id="view_sng_sales_route_list_control" model="ir.ui.view">
        <field name="name">sng.sales.route.list.control.visitas</field>
        <field name="model">sng.sales.route</field>
        <field name="inherit_id" ref="sng_sales_routes.view_sng_sales_route_list"/>
        <field name="arch" type="xml">
            <field name="salesperson_id" position="after">
                <field name="sng_tipo_atencion" optional="show"/>
                <field name="sng_frecuencia_visita" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
