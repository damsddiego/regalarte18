<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_control_visitas_generar_wizard_form" model="ir.ui.view">
        <field name="name">sng.control.visitas.generar.wizard.form</field>
        <field name="model">sng.control.visitas.generar.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalcular matriz">
                <group>
                    <field name="fecha"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generar" type="object" string="Recalcular"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_control_visitas_generar_wizard" model="ir.actions.act_window">
        <field name="name">Recalcular matriz</field>
        <field name="res_model">sng.control.visitas.generar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
