<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sng_pricelist_promotion_import_wizard_form" model="ir.ui.view">
        <field name="name">sng.pricelist.promotion.import.wizard.form</field>
        <field name="model">sng.pricelist.promotion.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar promociones">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </group>

                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>Formato esperado:</strong>
                        <ul>
                            <li>Columna Codigo: codigo del producto.</li>
                            <li>Columna Precio Remate: precio fijo base en moneda de la compania.</li>
                        </ul>
                        <p>La importacion crea una regla de precio fijo por producto en cada lista de precios activa. Para listas en otra moneda, usa el tipo de cambio fijo de la lista cuando existe; si esta vacio, usa el tipo de cambio del sistema.</p>
                    </div>
                </group>

                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_pricelist_promotion_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar promociones</field>
        <field name="res_model">sng.pricelist.promotion.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_sng_pricelist_promotion_import_wizard"
        name="Importar promociones"
        parent="sale.product_menu_catalog"
        action="action_sng_pricelist_promotion_import_wizard"
        sequence="31"
        groups="product.group_product_pricelist"/>

</odoo>
