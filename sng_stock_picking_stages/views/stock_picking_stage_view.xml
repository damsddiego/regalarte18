<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_stage_list" model="ir.ui.view">
        <field name="name">stock.picking.stage.list</field>
        <field name="model">stock.picking.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="picking_type_code"/>
                <field name="show_in_kanban"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_stock_picking_stage_form" model="ir.ui.view">
        <field name="name">stock.picking.stage.form</field>
        <field name="model">stock.picking.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="picking_type_code"/>
                            <field name="show_in_kanban"/>
                            <field name="fold"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_stage" model="ir.actions.act_window">
        <field name="name">Picking Stages</field>
        <field name="res_model">stock.picking.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_picking_stage"
              name="Picking Stages"
              action="sng_stock_picking_stages.action_stock_picking_stage"
              parent="stock.menu_warehouse_config"
              sequence="50"/>

</odoo>
