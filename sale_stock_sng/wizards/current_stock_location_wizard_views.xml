<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_current_stock_location_wizard_form" model="ir.ui.view">
    <field name="name">current.stock.location.wizard.form</field>
    <field name="model">current.stock.location.wizard</field>
    <field name="arch" type="xml">
      <form string="Reporte Existencias Actuales">
        <group>
          <group>
            <field name="user_id" options="{'no_create_edit': True, 'no_open': True}"/>
            <field name="partner_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
            <field name="location_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
          </group>
          <group>
            <field name="product_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
            <field name="only_positive"/>
          </group>
        </group>
        <footer>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
          <button string="Ver en pantalla" type="object" name="action_view_results" class="btn-primary"/>
          <button string="Exportar Excel" type="object" name="action_print" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_current_stock_location_line_list" model="ir.ui.view">
    <field name="name">current.stock.location.wizard.line.list</field>
    <field name="model">current.stock.location.wizard.line</field>
    <field name="arch" type="xml">
      <list string="Existencias Actuales" create="0" edit="0" delete="0">
        <field name="client_code"/>
        <field name="partner_id"/>
        <field name="location_id"/>
        <field name="product_code"/>
        <field name="product_id"/>
        <field name="quantity" sum="Cantidad actual"/>
        <field name="reserved_quantity" sum="Cantidad reservada"/>
        <field name="available_quantity" sum="Cantidad disponible"/>
        <field name="sale_price"/>
        <field name="total_value" sum="Valor total"/>
        <field name="salesperson_name"/>
        <field name="route_name"/>
      </list>
    </field>
  </record>

  <record id="view_current_stock_location_line_form" model="ir.ui.view">
    <field name="name">current.stock.location.wizard.line.form</field>
    <field name="model">current.stock.location.wizard.line</field>
    <field name="arch" type="xml">
      <form string="Existencias Actuales" create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="client_code"/>
              <field name="partner_id"/>
              <field name="location_id"/>
              <field name="salesperson_name"/>
              <field name="route_name"/>
            </group>
            <group>
              <field name="product_code"/>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="reserved_quantity"/>
              <field name="available_quantity"/>
              <field name="sale_price"/>
              <field name="total_value"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_current_stock_location_line_search" model="ir.ui.view">
    <field name="name">current.stock.location.wizard.line.search</field>
    <field name="model">current.stock.location.wizard.line</field>
    <field name="arch" type="xml">
      <search string="Existencias Actuales">
        <field name="partner_id"/>
        <field name="location_id"/>
        <field name="product_id"/>
        <field name="product_code"/>
        <field name="salesperson_name"/>
        <field name="route_name"/>
        <filter name="positive_qty" string="Con existencias" domain="[('quantity', '&gt;', 0)]"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
          <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
          <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
          <filter name="group_salesperson" string="Vendedor" context="{'group_by': 'salesperson_name'}"/>
          <filter name="group_route" string="Ruta" context="{'group_by': 'route_name'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_current_stock_location_line_pivot" model="ir.ui.view">
    <field name="name">current.stock.location.wizard.line.pivot</field>
    <field name="model">current.stock.location.wizard.line</field>
    <field name="arch" type="xml">
      <pivot string="Existencias Actuales">
        <field name="partner_id" type="row"/>
        <field name="product_id" type="row"/>
        <field name="quantity" type="measure"/>
        <field name="reserved_quantity" type="measure"/>
        <field name="available_quantity" type="measure"/>
        <field name="total_value" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="action_current_stock_location_wizard" model="ir.actions.act_window">
    <field name="name">Existencias Actuales por Ubicación</field>
    <field name="res_model">current.stock.location.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem
      id="menu_current_stock_location_wizard"
      name="Existencias Actuales por Ubicación"
      parent="menu_consign_cxc_root"
      action="action_current_stock_location_wizard"/>
</odoo>
