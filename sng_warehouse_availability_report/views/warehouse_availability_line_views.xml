<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_warehouse_availability_line_list" model="ir.ui.view">
        <field name="name">sng.warehouse.availability.line.list</field>
        <field name="model">sng.warehouse.availability.line</field>
        <field name="arch" type="xml">
            <list string="Disponibilidad por Almacenes" create="0" edit="0" delete="0">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="warehouse_group_id" optional="hide"/>
                <field name="warehouse_id"/>
                <field name="supplier_name"/>
                <field name="available_quantity" sum="Total disponible"/>
                <button name="action_open_product" string="Abrir producto" type="object" icon="fa-external-link" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_sng_warehouse_availability_line_search" model="ir.ui.view">
        <field name="name">sng.warehouse.availability.line.search</field>
        <field name="model">sng.warehouse.availability.line</field>
        <field name="arch" type="xml">
            <search string="Disponibilidad por Almacenes">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="warehouse_group_id"/>
                <field name="warehouse_id"/>
                <field name="vendor_id"/>
                <field name="supplier_name"/>
                <field name="available_quantity"/>
                <filter name="filter_available" string="Con disponibilidad" domain="[('available_quantity', '&gt;', 0)]"/>
                <filter name="filter_without_availability" string="Sin disponibilidad" domain="[('available_quantity', '&lt;=', 0)]"/>
                <separator/>
                <filter name="group_warehouse" string="Almacen" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_warehouse_group" string="Grupo de almacenes" context="{'group_by': 'warehouse_group_id'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_vendor" string="Proveedor" context="{'group_by': 'vendor_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_sng_warehouse_availability_line_pivot" model="ir.ui.view">
        <field name="name">sng.warehouse.availability.line.pivot</field>
        <field name="model">sng.warehouse.availability.line</field>
        <field name="arch" type="xml">
            <pivot string="Disponibilidad por Almacenes" disable_linking="True">
                <field name="product_id" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="available_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sng_warehouse_availability_line" model="ir.actions.act_window">
        <field name="name">Disponibilidad por Almacenes</field>
        <field name="res_model">sng.warehouse.availability.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_sng_warehouse_availability_line_search"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
