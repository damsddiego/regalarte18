<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sng_ai_fec_digitizer" model="ir.module.category">
        <field name="name">Digitalización IA FEC</field>
        <field name="sequence">51</field>
    </record>

    <record id="group_fec_digitizer_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_sng_ai_fec_digitizer"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_fec_digitizer_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_sng_ai_fec_digitizer"/>
        <field name="implied_ids" eval="[(4, ref('group_fec_digitizer_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_fec_digitizer_manager'))]"/>
    </record>

    <record id="rule_fec_batch_company" model="ir.rule">
        <field name="name">Lotes FEC IA por compañía</field>
        <field name="model_id" ref="model_sng_ai_fec_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_fec_proposal_company" model="ir.rule">
        <field name="name">Propuestas FEC IA por compañía</field>
        <field name="model_id" ref="model_sng_ai_fec_proposal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_fec_proposal_line_company" model="ir.rule">
        <field name="name">Líneas FEC IA por compañía</field>
        <field name="model_id" ref="model_sng_ai_fec_proposal_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>

