<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_supplier_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.purchase.supplier.report.wizard.form</field>
        <field name="model">sng.purchase.supplier.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Órdenes de compra por proveedor">
                <sheet>
                    <div class="oe_title">
                        <h1>Órdenes de compra por proveedor</h1>
                        <p class="text-muted">
                            Resumen por proveedor y producto, con detalle de lo
                            ordenado, recibido y pendiente de recibir.
                        </p>
                    </div>
                    <group>
                        <group string="Período de confirmación">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="reception_filter"/>
                        </group>
                        <group string="Alcance">
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="supplier_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Todos los proveedores"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>En tránsito:</strong>
                        incluye líneas sin recibir y parcialmente recibidas.
                        Las líneas completamente recibidas se excluyen aunque
                        pertenezcan a una orden con otros productos pendientes.
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            string="Ver en pantalla"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_pdf"
                            string="Imprimir PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx"
                            string="Descargar Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_supplier_report_wizard" model="ir.actions.act_window">
        <field name="name">Órdenes de compra por proveedor</field>
        <field name="res_model">sng.purchase.supplier.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_supplier_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_purchase_supplier_report"
              name="Órdenes por proveedor"
              parent="purchase.menu_purchase_root"
              action="action_purchase_supplier_report_wizard"
              sequence="98"
              groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
</odoo>
