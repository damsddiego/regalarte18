<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sng_unreconciled_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.unreconciled.report.wizard.form</field>
        <field name="model">sng.unreconciled.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturas y Pagos No Conciliados">
                <header>
                    <button name="action_generate" string="Generar Reporte" type="object" class="btn-primary"/>
                    <button name="action_download" string="Descargar Excel" type="object" class="btn-secondary"
                        invisible="invoice_line_count == 0 and payment_line_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Facturas y Pagos No Conciliados</h1>
                    </div>
                    <group>
                        <group string="Filtros">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="invoice_type" widget="radio"/>
                        </group>
                        <group string="Clientes y Proveedores">
                            <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="invoice_line_count" invisible="1"/>
                    <field name="payment_line_count" invisible="1"/>
                    <group string="Resumen" invisible="invoice_line_count == 0 and payment_line_count == 0">
                        <group>
                            <field name="invoice_line_count" readonly="1"/>
                            <field name="invoice_total_summary" readonly="1"/>
                            <field name="invoice_residual_summary" readonly="1"/>
                        </group>
                        <group>
                            <field name="payment_line_count" readonly="1"/>
                            <field name="payment_total_summary" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="invoice_line_count == 0 and payment_line_count == 0">
                        <page string="Facturas Pendientes" invisible="invoice_line_count == 0">
                            <field name="invoice_line_ids" readonly="1" nolabel="1">
                                <list string="Facturas Pendientes" create="0" delete="0"
                                    decoration-danger="days_overdue &gt; 0">
                                    <field name="partner_name" string="Cliente"/>
                                    <field name="invoice_name" string="Factura"/>
                                    <field name="invoice_date" string="Fecha"/>
                                    <field name="invoice_date_due" string="Vencimiento"/>
                                    <field name="days_overdue" string="Días Vencida"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="amount_residual" sum="Pendiente"/>
                                    <field name="currency_name"/>
                                    <field name="payment_state"/>
                                    <button name="action_open_invoice" type="object" icon="fa-external-link"
                                        title="Abrir factura"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pagos No Conciliados" invisible="payment_line_count == 0">
                            <field name="payment_line_ids" readonly="1" nolabel="1">
                                <list string="Pagos No Conciliados" create="0" delete="0"
                                    decoration-muted="applicable_invoice_count == 0">
                                    <field name="partner_name" string="Cliente/Proveedor"/>
                                    <field name="payment_name" string="Pago"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_name"/>
                                    <field name="applicable_invoice_count"/>
                                    <field name="applicable_invoice_names"/>
                                    <field name="applicable_invoice_residual_summary"/>
                                    <field name="journal_name"/>
                                    <field name="payment_method_name"/>
                                    <button name="action_open_payment" type="object" icon="fa-external-link"
                                        title="Abrir pago"/>
                                    <button name="action_open_reconcile" string="Conciliar"
                                        type="object" icon="fa-exchange" title="Conciliar este pago con facturas pendientes"
                                        invisible="applicable_invoice_count == 0"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_unreconciled_report_wizard" model="ir.actions.act_window">
        <field name="name">Facturas y Pagos No Conciliados</field>
        <field name="res_model">sng.unreconciled.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_sng_unreconciled_report"
        name="Facturas y Pagos No Conciliados"
        parent="account.menu_finance_receivables"
        action="action_sng_unreconciled_report_wizard"
        sequence="200"
    />

</odoo>
