<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_commercial_plan_export_wizard_form" model="ir.ui.view">
        <field name="name">sng.commercial.plan.export.wizard.form</field>
        <field name="model">sng.commercial.plan.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Plan Comercial">
                <sheet>
                    <group>
                        <field name="plan_id" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="file_name" readonly="1" invisible="state != 'done'"/>
                        <field name="file_data" filename="file_name" readonly="1" invisible="state != 'done'"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
