<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_envio_audit_user" model="res.groups">
            <field name="name">Usuario auditoría de envíos</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_envio_audit_manager" model="res.groups">
            <field name="name">Responsable auditoría de envíos</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('sng_envio_mercaderia.group_envio_audit_user'))]"/>
        </record>

        <record id="rule_envio_audit_company" model="ir.rule">
            <field name="name">Auditorías de envío por compañía</field>
            <field name="model_id" ref="model_sng_envio_mercaderia"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('sng_envio_mercaderia.group_envio_audit_user'))]"/>
        </record>
    </data>
</odoo>

