<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_envio_mercaderia">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 16px;">
                    <div style="border: 1px solid #222; min-height: 190mm;">
                        <div style="padding: 8px 10px 4px 10px; min-height: 48mm;">
                            <div style="font-size: 20px; font-weight: 700;">
                                <span t-esc="o.company_name"/>
                            </div>
                            <div t-if="o.company_address" style="font-size: 12px; margin-top: 8px;">
                                <span t-esc="o.company_address"/>
                            </div>
                            <div t-if="o.company_phone" style="font-size: 12px;">
                                Teléfono: <span t-esc="o.company_phone"/>
                            </div>
                            <div style="text-align: right; margin-top: -16px; margin-right: 100px; font-size: 13px;">
                                <strong>Fecha</strong>
                                <span style="display: inline-block; margin-left: 42px;"
                                      t-field="o.document_date"
                                      t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </div>
                            <div style="text-align: center; font-size: 26px; font-weight: 700; margin-top: 32px;">
                                ENVÍO DE MERCADERÍA
                            </div>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                            <tbody>
                                <tr>
                                    <td style="width: 29%; border: 1px solid #222; padding: 6px 8px; text-align: right; font-weight: 700; font-size: 20px;">TRANSPORTE:</td>
                                    <td style="border: 1px solid #222; padding: 6px 8px; font-size: 20px;">
                                        <span t-esc="o.delivery_method"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #222; padding: 6px 8px; text-align: right; font-weight: 700; font-size: 20px;">CLIENTE:</td>
                                    <td style="border: 1px solid #222; padding: 6px 8px; font-size: 20px;">
                                        <span t-esc="o.customer_name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #222; padding: 16px 8px; text-align: right; font-weight: 700; font-size: 20px;">LUGAR:</td>
                                    <td style="border: 1px solid #222; padding: 16px 8px; font-size: 20px;">
                                        <span t-esc="o.delivery_address"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #222; padding: 6px 8px; text-align: right; font-weight: 700; font-size: 20px;">CONTACTO:</td>
                                    <td style="border: 1px solid #222; padding: 6px 8px; font-size: 20px;">
                                        <span t-esc="o.contact_name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #222; padding: 6px 8px; text-align: right; font-weight: 700; font-size: 20px;">TELÉFONO:</td>
                                    <td style="border: 1px solid #222; padding: 6px 8px; font-size: 20px;">
                                        <span t-esc="o.contact_phone"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid #222; padding: 6px 8px; text-align: right; font-weight: 700; font-size: 20px;">TOTAL DE CAJAS:</td>
                                    <td style="border: 1px solid #222; padding: 6px 8px; font-size: 20px;">
                                        <span t-esc="o.boxes_label"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="padding: 12px 16px; font-size: 11px; color: #555;">
                            <span t-esc="o.name"/> ·
                            Orden: <span t-esc="o.source_reference"/> ·
                            Alistado por: <span t-esc="o.picker_name"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

