<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_fake_reconcile_config_tree" model="ir.ui.view">
        <field name="name">sng.fake.reconcile.config.tree</field>
        <field name="model">sng.fake.reconcile.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="journal_id"/>
                <field name="date_tolerance_days"/>
                <field name="amount_tolerance_pct"/>
                <field name="min_score_to_suggest"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sng_fake_reconcile_config_form" model="ir.ui.view">
        <field name="name">sng.fake.reconcile.config.form</field>
        <field name="model">sng.fake.reconcile.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Criterios de Matching">
                        <group>
                            <field name="date_tolerance_days"/>
                            <field name="amount_tolerance_pct"/>
                        </group>
                        <group>
                            <field name="min_score_to_suggest"/>
                            <field name="min_score_gap"/>
                        </group>
                    </group>
                    <group string="Habilitar Criterios">
                        <field name="enable_amount_date_match"/>
                        <field name="enable_partner_match"/>
                        <field name="enable_reference_match"/>
                        <field name="reference_regex" invisible="not enable_reference_match"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sng_fake_reconcile_config" model="ir.actions.act_window">
        <field name="name">Configuración Conciliación Falsa</field>
        <field name="res_model">sng.fake.reconcile.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
