<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_new_reactivated_customer_report_tree" model="ir.ui.view">
        <field name="name">sng.new.reactivated.customer.report.tree</field>
        <field name="model">sng.new.reactivated.customer.report</field>
        <field name="arch" type="xml">
            <list string="Clientes Nuevos-React" create="0" edit="0" delete="0" default_order="last_invoice_date desc, partner_name">
                <field name="report_type" optional="show"/>
                <field name="partner_code" string="Codigo"/>
                <field name="partner_name" string="Nombre"/>
                <field name="partner_create_date" string="Fecha de creacion"/>
                <field name="sales_route_id" string="Ruta"/>
                <field name="salesperson_id" string="Vendedor"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="previous_invoice_date"/>
                <field name="previous_invoice_amount" sum="Monto factura anterior"/>
                <field name="last_invoice_date"/>
                <field name="last_invoice_amount" sum="Monto ultima factura"/>
                <button name="action_open_partner" type="object" string="Cliente" class="btn-link"/>
                <button name="action_open_last_invoice" type="object" string="Factura" class="btn-link" invisible="not last_invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_sng_new_reactivated_customer_report_search" model="ir.ui.view">
        <field name="name">sng.new.reactivated.customer.report.search</field>
        <field name="model">sng.new.reactivated.customer.report</field>
        <field name="arch" type="xml">
            <search string="Clientes Nuevos-React">
                <field name="partner_code"/>
                <field name="partner_name"/>
                <field name="partner_id"/>
                <field name="sales_route_id"/>
                <field name="salesperson_id"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <filter name="filter_new" string="Nuevos" domain="[('report_type', '=', 'new')]"/>
                <filter name="filter_reactivated" string="Reactivados" domain="[('report_type', '=', 'reactivated')]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_by_type" string="Tipo" context="{'group_by': 'report_type'}"/>
                    <filter name="group_by_salesperson" string="Vendedor" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_by_route" string="Ruta" context="{'group_by': 'sales_route_id'}"/>
                    <filter name="group_by_company" string="Compania" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sng_new_reactivated_customer_report_pivot" model="ir.ui.view">
        <field name="name">sng.new.reactivated.customer.report.pivot</field>
        <field name="model">sng.new.reactivated.customer.report</field>
        <field name="arch" type="xml">
            <pivot string="Clientes Nuevos-React">
                <field name="report_type" type="row"/>
                <field name="salesperson_id" type="row"/>
                <field name="last_invoice_amount" type="measure"/>
                <field name="previous_invoice_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sng_new_reactivated_customer_report" model="ir.actions.act_window">
        <field name="name">Clientes Nuevos-React</field>
        <field name="res_model">sng.new.reactivated.customer.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_sng_new_reactivated_customer_report_search"/>
        <field name="domain">[('run_user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p>Ejecute el asistente para generar el reporte.</p>
        </field>
    </record>
</odoo>
