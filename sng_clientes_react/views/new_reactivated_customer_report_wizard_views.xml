<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_new_reactivated_customer_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.new.reactivated.customer.report.wizard.form</field>
        <field name="model">sng.new.reactivated.customer.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Clientes Nuevos-React">
                <group>
                    <group string="Periodo">
                        <field name="month_date"/>
                        <field name="inactivity_months"/>
                    </group>
                    <group string="Filtros">
                        <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_open_report" string="Ver Reporte" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_new_reactivated_customer_report_wizard" model="ir.actions.act_window">
        <field name="name">Clientes Nuevos-React</field>
        <field name="res_model">sng.new.reactivated.customer.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
