<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Regla multi-compañía: cada usuario ve solo las visitas de las
         compañías que tiene habilitadas. Sin esta regla, un usuario de la
         compañía A veía las visitas de todas las compañías. -->
    <record id="sng_ruteros_visita_comp_rule" model="ir.rule">
        <field name="name">Visita rutero: multi-compañía</field>
        <field name="model_id" ref="model_sng_ruteros_visita"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
