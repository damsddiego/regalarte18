<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_customer_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.product.customer.report.wizard.form</field>
        <field name="model">sng.product.customer.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Clientes por producto facturado">
                <sheet>
                    <group>
                        <group string="Productos">
                            <field name="product_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Seleccione uno o varios productos"/>
                        </group>
                        <group string="Período y compañía">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Se mostrarán los clientes que recibieron los productos
                        seleccionados en facturas y notas de crédito publicadas.
                        Las notas de crédito reducen cantidades e importes.
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            string="Ver en pantalla"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_pdf"
                            string="Imprimir PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx"
                            string="Descargar Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_customer_report_wizard" model="ir.actions.act_window">
        <field name="name">Clientes por producto facturado</field>
        <field name="res_model">sng.product.customer.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_customer_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_customer_report"
              name="Clientes por producto facturado"
              parent="account.menu_finance_reports"
              action="action_product_customer_report_wizard"
              sequence="106"
              groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>
