<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_product_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.customer.product.report.wizard.form</field>
        <field name="model">sng.customer.product.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Productos facturados por cliente">
                <sheet>
                    <group>
                        <group string="Cliente y período">
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filtros">
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="product_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Todos los productos"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Se incluyen únicamente facturas y notas de crédito
                        publicadas. Las notas de crédito se muestran con signo
                        negativo y reducen los totales netos.
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            string="Ver en pantalla"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_pdf"
                            string="Imprimir PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx"
                            string="Descargar Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_product_report_wizard" model="ir.actions.act_window">
        <field name="name">Productos facturados por cliente</field>
        <field name="res_model">sng.customer.product.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_customer_product_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_customer_product_report"
              name="Productos facturados por cliente"
              parent="account.menu_finance_reports"
              action="action_customer_product_report_wizard"
              sequence="105"
              groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>
