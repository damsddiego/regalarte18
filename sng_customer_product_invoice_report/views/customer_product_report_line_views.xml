<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_product_report_line_list" model="ir.ui.view">
        <field name="name">sng.customer.product.report.line.list</field>
        <field name="model">sng.customer.product.report.line</field>
        <field name="arch" type="xml">
            <list string="Productos facturados por cliente"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-danger="is_credit_note">
                <header>
                    <button name="action_export_xlsx"
                            string="Descargar Excel"
                            type="object"
                            class="btn-primary"
                            display="always"/>
                    <button name="action_print_pdf"
                            string="Imprimir PDF"
                            type="object"
                            class="btn-secondary"
                            display="always"/>
                    <button name="action_open_filters"
                            string="Cambiar filtros"
                            type="object"
                            class="btn-secondary"
                            display="always"/>
                </header>
                <field name="wizard_id" column_invisible="1"/>
                <field name="is_credit_note" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="invoice_date"/>
                <field name="document_type"/>
                <field name="move_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="invoice_partner_id"/>
                <field name="product_code" optional="show"/>
                <field name="product_id"/>
                <field name="quantity" sum="Cantidad neta"/>
                <field name="uom_id"/>
                <field name="price_unit"/>
                <field name="discount" optional="show"/>
                <field name="subtotal" sum="Subtotal"/>
                <field name="tax_amount" sum="IVA"/>
                <field name="total" sum="Total"/>
                <field name="currency_id"/>
                <field name="base_quantity"
                       sum="Cantidad base neta"
                       optional="hide"/>
                <field name="base_uom_id" optional="hide"/>
                <field name="subtotal_company"
                       sum="Subtotal CRC"
                       optional="show"/>
                <field name="tax_amount_company"
                       sum="IVA CRC"
                       optional="show"/>
                <field name="total_company"
                       sum="Total CRC"
                       optional="show"/>
                <field name="company_id"
                       optional="hide"
                       groups="base.group_multi_company"/>
                <button name="action_open_invoice"
                        string="Abrir"
                        type="object"
                        icon="fa-external-link"
                        class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_customer_product_report_line_search" model="ir.ui.view">
        <field name="name">sng.customer.product.report.line.search</field>
        <field name="model">sng.customer.product.report.line</field>
        <field name="arch" type="xml">
            <search string="Productos facturados por cliente">
                <field name="document_number"/>
                <field name="partner_id"/>
                <field name="invoice_partner_id"/>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="invoice_date"/>
                <filter name="filter_invoices"
                        string="Facturas"
                        domain="[('document_type', '=', 'out_invoice')]"/>
                <filter name="filter_credit_notes"
                        string="Notas de crédito"
                        domain="[('document_type', '=', 'out_refund')]"/>
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter name="group_product"
                            string="Producto"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_document"
                            string="Documento"
                            context="{'group_by': 'move_id'}"/>
                    <filter name="group_invoice_partner"
                            string="Contacto facturado"
                            context="{'group_by': 'invoice_partner_id'}"/>
                    <filter name="group_document_type"
                            string="Tipo de documento"
                            context="{'group_by': 'document_type'}"/>
                    <filter name="group_month"
                            string="Mes"
                            context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="group_company"
                            string="Compañía"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_customer_product_report_line_pivot" model="ir.ui.view">
        <field name="name">sng.customer.product.report.line.pivot</field>
        <field name="model">sng.customer.product.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Resumen neto por producto" disable_linking="True">
                <field name="product_id" type="row"/>
                <field name="base_uom_id" type="row"/>
                <field name="base_quantity" type="measure"/>
                <field name="subtotal_company" type="measure"/>
                <field name="tax_amount_company" type="measure"/>
                <field name="total_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_customer_product_report_line" model="ir.actions.act_window">
        <field name="name">Productos facturados por cliente</field>
        <field name="res_model">sng.customer.product.report.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_customer_product_report_line_search"/>
    </record>
</odoo>
