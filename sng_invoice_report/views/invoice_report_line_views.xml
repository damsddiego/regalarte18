<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_report_line_list" model="ir.ui.view">
        <field name="name">invoice.report.line.list</field>
        <field name="model">invoice.report.line</field>
        <field name="arch" type="xml">
            <list string="Invoice Report by Salesperson" create="0" edit="0" delete="0"
                  default_group_by="salesperson_id">
                <field name="move_id"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="company_id" optional="show"/>
                <field name="invoice_user_id" optional="show"/>
                <field name="original_salesperson_id" optional="show"/>
                <field name="salesperson_id" optional="show"/>
                <field name="move_type"/>
                <field name="payment_state" optional="hide"/>
                <field name="currency_id"/>
                <field name="amount_untaxed" sum="Untaxed"/>
                <field name="amount_tax" sum="Tax"/>
                <field name="amount_total" sum="Total"/>
                <field name="company_currency_id" optional="hide"/>
                <field name="amount_untaxed_company" sum="Subtotal (Company Currency)" optional="show"/>
                <field name="amount_tax_company" sum="Tax (Company Currency)" optional="show"/>
                <field name="amount_total_company" sum="Total (Company Currency)" optional="show"/>
                <button name="action_open_invoice" string="Open Invoice" type="object"
                        icon="fa-external-link" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_report_line_search" model="ir.ui.view">
        <field name="name">invoice.report.line.search</field>
        <field name="model">invoice.report.line</field>
        <field name="arch" type="xml">
            <search string="Invoice Report by Salesperson">
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="invoice_user_id"/>
                <field name="original_salesperson_id"/>
                <field name="salesperson_id"/>
                <field name="company_id"/>
                <field name="invoice_date"/>
                <separator/>
                <filter name="group_salesperson" string="Report Salesperson"
                        context="{'group_by': 'salesperson_id'}"/>
                <filter name="group_original_salesperson" string="Original Salesperson"
                        context="{'group_by': 'original_salesperson_id'}"/>
                <filter name="group_invoice_user" string="Invoice Responsible"
                        context="{'group_by': 'invoice_user_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_invoice_report_line_pivot" model="ir.ui.view">
        <field name="name">invoice.report.line.pivot</field>
        <field name="model">invoice.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Invoice Report by Salesperson" disable_linking="True">
                <field name="salesperson_id" type="row"/>
                <field name="company_id" type="col"/>
                <field name="amount_untaxed_company" type="measure"/>
                <field name="amount_tax_company" type="measure"/>
                <field name="amount_total_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_invoice_report_line_graph" model="ir.ui.view">
        <field name="name">invoice.report.line.graph</field>
        <field name="model">invoice.report.line</field>
        <field name="arch" type="xml">
            <graph string="Invoice Report by Salesperson" type="bar">
                <field name="salesperson_id"/>
                <field name="amount_total_company" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_invoice_report_line" model="ir.actions.act_window">
        <field name="name">Invoice Report by Salesperson</field>
        <field name="res_model">invoice.report.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_invoice_report_line_search"/>
        <field name="context">{'search_default_group_salesperson': 1}</field>
    </record>
</odoo>
