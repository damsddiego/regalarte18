<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredar la vista form de stock.picking para modificar la lista embebida de move_ids_without_package -->
    <record id="view_picking_form_inherit_sng_stock_line_sum" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.sng.stock.line.sum</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Agregar número de línea antes del producto -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="before">
                <field name="line_number" width="40px"/>
            </xpath>

            <!-- Agregar sumatoria al campo de demanda -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="sum">Total Demand</attribute>
            </xpath>

            <!-- Agregar sumatoria al campo de cantidad realizada -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='quantity']" position="attributes">
                <attribute name="sum">Total Quantity</attribute>
            </xpath>
        </field>
    </record>

</odoo>
