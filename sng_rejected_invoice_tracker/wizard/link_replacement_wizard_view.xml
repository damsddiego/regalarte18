<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIZARD: VINCULAR FACTURA DE REEMPLAZO EXISTENTE
         ============================================================ -->
    <record id="view_rejected_invoice_replacement_wizard_form" model="ir.ui.view">
        <field name="name">rejected.invoice.replacement.wizard.form</field>
        <field name="model">rejected.invoice.replacement.wizard</field>
        <field name="arch" type="xml">
            <form string="Vincular Documento de Reemplazo">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Vincular reemplazo manualmente</strong> — Seleccione un documento
                        ya existente, aceptado por Hacienda o de tipo Documento Electrónico
                        Deshabilitado, para vincularlo como reemplazo del documento rechazado.
                    </div>

                    <group>
                        <group string="Documento Rechazado">
                            <field name="rejected_invoice_id"/>
                            <field name="rejected_move_type" invisible="1"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Documento de Reemplazo">
                            <field
                                name="replacement_invoice_id"
                                options="{'no_create': True, 'no_edit': True}"
                            />
                        </group>
                    </group>

                    <field name="notes" placeholder="Notas opcionales sobre este reemplazo..."/>
                </sheet>

                <footer>
                    <button
                        name="action_link_replacement"
                        type="object"
                        string="Vincular Reemplazo"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>
