<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rule for Rejected Invoice Replacement History -->
    <record id="rule_rejected_history_multicompany" model="ir.rule">
        <field name="name">Rejected History: Multi-Company Access</field>
        <field name="model_id" ref="model_rejected_invoice_replacement_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
