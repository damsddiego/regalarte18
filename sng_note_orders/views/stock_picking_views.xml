<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_line_notes" model="ir.ui.view">
        <field name="name">stock.picking.form.line.notes</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="sng_line_note" string="Nota" optional="show" placeholder="Nota de la linea..."/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations_line_notes" model="ir.ui.view">
        <field name="name">stock.move.operations.form.line.notes</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sng_line_note" placeholder="Nota de la linea..."/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_line_notes" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.line.notes</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="sng_line_note" string="Nota" optional="show" placeholder="Nota de la linea..."/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_line_notes" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.line.notes</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="sng_line_note" string="Nota" optional="show" placeholder="Nota de la linea..."/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_line_notes" model="ir.ui.view">
        <field name="name">stock.move.line.form.line.notes</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sng_line_note" placeholder="Nota de la linea..."/>
            </xpath>
        </field>
    </record>
</odoo>
