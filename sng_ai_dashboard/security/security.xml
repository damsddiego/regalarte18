<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sng_ai_dashboard" model="ir.module.category">
        <field name="name">Dashboard IA</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_ai_dashboard_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_sng_ai_dashboard"/>
        <field name="comment">Puede ver el Dashboard IA y generar análisis.</field>
    </record>

    <!-- Ya no se implica desde Ajustes: el acceso se asigna usuario por usuario.
         (3, ...) quita la implicación que dejaban las versiones anteriores. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_ai_dashboard_user'))]"/>
    </record>
</odoo>
