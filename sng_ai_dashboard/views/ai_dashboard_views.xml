<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción cliente del dashboard -->
    <record id="action_ai_dashboard" model="ir.actions.client">
        <field name="name">Dashboard IA</field>
        <field name="tag">sng_ai_dashboard</field>
    </record>

    <!-- Historial de análisis -->
    <record id="view_ai_analysis_list" model="ir.ui.view">
        <field name="name">sng.ai.dashboard.analysis.list</field>
        <field name="model">sng.ai.dashboard.analysis</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="create_date"/>
                <field name="origin"/>
                <field name="period_months"/>
                <field name="provider_used" optional="show"/>
                <field name="model_used"/>
                <field name="input_tokens" optional="hide"/>
                <field name="output_tokens" optional="hide"/>
                <field name="cost_usd" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_ai_analysis_form" model="ir.ui.view">
        <field name="name">sng.ai.dashboard.analysis.form</field>
        <field name="model">sng.ai.dashboard.analysis</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="origin"/>
                            <field name="period_months"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="provider_used"/>
                            <field name="model_used"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cost_usd"/>
                        </group>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_analysis" model="ir.actions.act_window">
        <field name="name">Historial de análisis</field>
        <field name="res_model">sng.ai.dashboard.analysis</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_ai_dashboard_root" name="Dashboard IA"
              groups="sng_ai_dashboard.group_ai_dashboard_user"
              web_icon="sng_ai_dashboard,static/description/icon.png"
              sequence="5"/>
    <menuitem id="menu_ai_dashboard" name="Dashboard"
              parent="menu_ai_dashboard_root"
              action="action_ai_dashboard" sequence="10"/>
    <menuitem id="menu_ai_analysis" name="Historial de análisis"
              parent="menu_ai_dashboard_root"
              action="action_ai_analysis" sequence="20"/>
</odoo>
