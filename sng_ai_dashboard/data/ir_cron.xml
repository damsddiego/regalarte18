<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_generate_ai_analysis" model="ir.cron">
            <field name="name">Dashboard IA: análisis automático (2 veces al día)</field>
            <field name="model_id" ref="model_sng_ai_dashboard"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_analysis()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=12, minute=30, second=0)"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
