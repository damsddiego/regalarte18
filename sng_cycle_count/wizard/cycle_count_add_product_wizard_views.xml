<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cycle_count_add_product_wizard_form" model="ir.ui.view">
        <field name="name">sng.cycle.count.add.product.wizard.form</field>
        <field name="model">sng.cycle.count.add.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar producto al conteo">
                <group>
                    <field name="cycle_count_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="allowed_location_ids" invisible="1"/>
                    <field name="tracking" invisible="1"/>
                    <field name="product_id"/>
                    <field name="location_id" domain="allowed_location_ids and [('id', 'in', allowed_location_ids)] or [('usage', 'in', ('internal', 'transit'))]"/>
                    <field name="lot_id" invisible="tracking == 'none'" required="tracking != 'none'"/>
                    <field name="counted_qty"/>
                    <field name="notes" placeholder="Ej.: sobrante encontrado durante el conteo..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Agregar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
