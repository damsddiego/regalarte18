<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sng_analisis_compras_wizard_form" model="ir.ui.view">
        <field name="name">sng.analisis.compras.wizard.form</field>
        <field name="model">sng.analisis.compras.wizard</field>
        <field name="arch" type="xml">
            <form string="Análisis de Compras">
                <sheet>
                    <div class="oe_title">
                        <h1>Análisis de Ventas y Sugerido de Compras</h1>
                        <p class="text-muted">
                            Ventas facturadas (neto de notas de crédito), historial de 6 meses,
                            inventario actual y cantidad sugerida de compra por producto.
                        </p>
                    </div>
                    <group string="Período y cobertura">
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="coverage_months"/>
                            <field name="include_lead_time"/>
                            <field name="include_undelivered"/>
                        </group>
                    </group>
                    <group string="Alcance">
                        <group>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                            <field name="warehouse_group_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="warehouse_ids" widget="many2many_tags" readonly="warehouse_group_id"/>
                            <field name="location_ids" widget="many2many_tags"/>
                            <field name="sales_all_warehouses"
                                   invisible="not warehouse_group_id and not warehouse_ids"/>
                        </group>
                    </group>
                    <group string="Filtros de producto">
                        <group>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="proveedor_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="product_code"/>
                            <field name="only_with_sales"/>
                        </group>
                    </group>
                    <group string="Detección de ventas atípicas">
                        <group>
                            <field name="outlier_threshold"/>
                        </group>
                        <group>
                            <field name="min_history_months"/>
                        </group>
                    </group>
                    <group string="Modelo de inventario ajustado">
                        <group>
                            <field name="service_factor"/>
                            <field name="cv_threshold"/>
                        </group>
                        <group>
                            <field name="excess_factor"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Nota:</strong>
                        "Hace 1m" corresponde al mes de la fecha hasta.
                        Los colores en "Meses Inv." indican:
                        <span class="badge" style="background:#c00;color:#fff">Rojo</span> sobrestock (&gt;12 meses),
                        <span class="badge" style="background:#e07000;color:#fff">Naranja</span> sin ventas con inventario,
                        <span class="badge" style="background:#2e7d32;color:#fff">Verde</span> stock bajo (≤3 meses).
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            string="Ver en pantalla"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_xlsx"
                            string="Exportar XLSX"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_analisis_compras_wizard" model="ir.actions.act_window">
        <field name="name">Análisis de Compras</field>
        <field name="res_model">sng.analisis.compras.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Compras -->
    <menuitem
        id="menu_sng_analisis_compras_purchase"
        name="Análisis de Compras"
        parent="purchase.menu_purchase_root"
        action="action_sng_analisis_compras_wizard"
        sequence="81"
        groups="purchase.group_purchase_user,purchase.group_purchase_manager"
    />

    <!-- Ventas > Reportes -->
    <menuitem
        id="menu_sng_analisis_compras_sale"
        name="Análisis de Compras"
        parent="sale.menu_sale_report"
        action="action_sng_analisis_compras_wizard"
        sequence="51"
        groups="purchase.group_purchase_user,purchase.group_purchase_manager"
    />

    <!-- Inventario > Reportes -->
    <menuitem
        id="menu_sng_analisis_compras_stock"
        name="Análisis de Compras"
        parent="stock.menu_warehouse_report"
        action="action_sng_analisis_compras_wizard"
        sequence="51"
        groups="purchase.group_purchase_user,purchase.group_purchase_manager"
    />

</odoo>
