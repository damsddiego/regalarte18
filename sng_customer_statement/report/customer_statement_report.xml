<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato compacto: el A4 base reserva 52 mm para un encabezado externo. -->
    <record id="paperformat_customer_statement" model="report.paperformat">
        <field name="name">Estado de Cuenta de Clientes</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Acción de reporte QWeb PDF -->
    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Estado de Cuenta de Clientes</field>
        <field name="model">sng.customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sng_customer_statement.report_customer_statement_doc</field>
        <field name="report_file">sng_customer_statement.report_customer_statement_doc</field>
        <field name="print_report_name">'Estado_Cuenta_Clientes_%s_%s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="paperformat_id" ref="sng_customer_statement.paperformat_customer_statement"/>
    </record>
</odoo>
