<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_regalia" model="report.paperformat">
        <field name="name">Comprobante de regalía</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_regalia" model="ir.actions.report">
        <field name="name">Comprobante de Entrega de Regalía</field>
        <field name="model">sng.regalia</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sng_entrega_regalias.report_regalia</field>
        <field name="report_file">sng_entrega_regalias.report_regalia</field>
        <field name="print_report_name">'Regalía - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sng_entrega_regalias.model_sng_regalia"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sng_entrega_regalias.paperformat_regalia"/>
    </record>
</odoo>
