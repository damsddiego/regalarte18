<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_kardex_wizard_form" model="ir.ui.view">
        <field name="name">stock.kardex.wizard.form</field>
        <field name="model">stock.kardex.wizard</field>
        <field name="arch" type="xml">
            <form string="Kardex de Inventario">
                <group>
                    <group>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="location_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" string="Ver Kardex" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_print_pdf" string="Imprimir PDF" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_kardex_wizard" model="ir.actions.act_window">
        <field name="name">Kardex de Inventario</field>
        <field name="res_model">stock.kardex.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_kardex_wizard"
              name="Kardex de Inventario"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_kardex_wizard"
              groups="stock.group_stock_user"
              sequence="150"/>
</odoo>
