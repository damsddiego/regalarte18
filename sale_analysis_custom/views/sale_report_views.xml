<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Tree/List View -->
    <record id="sale_report_view_tree_inherit" model="ir.ui.view">
        <field name="name">sale.report.view.list.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <!-- Add salesperson_partner_id after user_id -->
            <field name="user_id" position="after">
                <field name="salesperson_partner_id" optional="show"/>
            </field>
            <field name="product_uom_qty" position="after">
                <field name="ordered_qty" optional="hide" sum="Total cant. ordenada"/>
                <field name="delivered_qty" optional="hide" sum="Total cant. entregada"/>
                <field name="denied_qty" optional="hide" sum="Total negado"/>
                <field name="invoiced_qty" optional="hide" sum="Total cant. facturada"/>
            </field>
            <field name="price_subtotal" position="after">
                <field name="ordered_amount" optional="hide" sum="Total monto ordenado"/>
                <field name="delivered_amount" optional="hide" sum="Total monto entregado"/>
                <field name="denied_amount" optional="hide" sum="Total monto negado"/>
                <field name="invoiced_amount" optional="hide" sum="Total monto facturado"/>
            </field>
        </field>
    </record>

    <!-- Extend Search View -->
    <record id="view_order_product_search_inherit" model="ir.ui.view">
        <field name="name">sale.report.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <!-- Add salesperson_partner_id as searchable field -->
            <field name="user_id" position="after">
                <field name="salesperson_partner_id"/>
            </field>

            <!-- Add group by option for salesperson partner -->
            <filter name="User" position="after">
                <filter string="Vendedor (Contacto)" name="salesperson_partner" context="{'group_by':'salesperson_partner_id'}"/>
            </filter>

            <filter name="fully_invoiced" position="after">
                <filter string="Con factura" name="has_invoice" domain="[('has_invoice', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Extend Pivot View -->
    <record id="view_order_product_pivot_inherit" model="ir.ui.view">
        <field name="name">sale.report.pivot.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <!-- Make salesperson_partner_id available in pivot -->
            <field name="team_id" position="after">
                <field name="salesperson_partner_id" type="row"/>
            </field>
        </field>
    </record>

    <record id="view_salesperson_contact_delivery_invoice_pivot" model="ir.ui.view">
        <field name="name">sale.report.salesperson.contact.delivery.invoice.pivot</field>
        <field name="model">sale.report</field>
        <field name="arch" type="xml">
            <pivot string="Ventas por Vendedor y Contacto" sample="1">
                <field name="salesperson_partner_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="ordered_qty" type="measure"/>
                <field name="ordered_amount" type="measure"/>
                <field name="delivered_qty" type="measure"/>
                <field name="denied_qty" type="measure"/>
                <field name="delivered_amount" type="measure"/>
                <field name="denied_amount" type="measure"/>
                <field name="invoiced_qty" type="measure"/>
                <field name="invoiced_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_salesperson_contact_delivery_invoice_analysis" model="ir.actions.act_window">
        <field name="name">Ventas por Vendedor y Contacto</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_salesperson_contact_delivery_invoice_pivot"/>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', '!=', 'cancel'), ('has_invoice', '=', True)]</field>
        <field name="context">{'search_default_Sales': 1, 'search_default_salesperson_partner': 1, 'search_default_Customer': 1, 'search_default_filter_order_date': 1}</field>
    </record>

    <menuitem
        id="menu_salesperson_contact_delivery_invoice_analysis"
        name="Ventas por Vendedor y Contacto"
        parent="sale.menu_sale_report"
        action="action_salesperson_contact_delivery_invoice_analysis"
        sequence="47"
        groups="sales_team.group_sale_manager"
    />

</odoo>
