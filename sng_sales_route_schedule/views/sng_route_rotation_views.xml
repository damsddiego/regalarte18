<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_rotation_list" model="ir.ui.view">
        <field name="name">sng.route.rotation.list</field>
        <field name="model">sng.route.rotation</field>
        <field name="arch" type="xml">
            <list string="Rotaciones">
                <field name="sequence" widget="handle"/>
                <field name="salesperson_id"/>
                <field name="cycle_weeks"/>
                <field name="start_slot_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_route_rotation_form" model="ir.ui.view">
        <field name="name">sng.route.rotation.form</field>
        <field name="model">sng.route.rotation</field>
        <field name="arch" type="xml">
            <form string="Rotación de rutas">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="start_slot_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="cycle_weeks"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Cada línea es una semana del ciclo, en orden. Una semana puede
                        tener varias rutas (por ejemplo GAM + Zona Santos).
                    </div>
                    <field name="slot_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="route_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_route_rotation" model="ir.actions.act_window">
        <field name="name">Rotaciones por asesor</field>
        <field name="res_model">sng.route.rotation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
