<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_compliance_list" model="ir.ui.view">
        <field name="name">sng.route.schedule.compliance.list</field>
        <field name="model">sng.route.schedule.compliance</field>
        <field name="arch" type="xml">
            <list string="Cumplimiento" create="0" edit="0" delete="0"
                  decoration-success="estado == 'visitado'"
                  decoration-danger="estado == 'no_visitado'"
                  decoration-muted="estado == 'cerrado'">
                <field name="week_start"/>
                <field name="salesperson_id"/>
                <field name="route_id"/>
                <field name="partner_id"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'visitado'"
                       decoration-danger="estado == 'no_visitado'"
                       decoration-warning="estado == 'pendiente'"/>
                <field name="visitas" sum="Visitas"/>
                <field name="resultado_comercial" optional="show"/>
                <field name="motivo_sin_venta_id" optional="show"/>
                <field name="visita_id" optional="hide"/>
                <field name="programados" sum="Programados" optional="hide"/>
                <field name="visitados" sum="Visitados" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_route_compliance_pivot" model="ir.ui.view">
        <field name="name">sng.route.schedule.compliance.pivot</field>
        <field name="model">sng.route.schedule.compliance</field>
        <field name="arch" type="xml">
            <pivot string="Cumplimiento del cronograma" disable_linking="0">
                <field name="salesperson_id" type="row"/>
                <field name="route_id" type="row"/>
                <field name="week_start" interval="week" type="col"/>
                <field name="programados" type="measure"/>
                <field name="visitados" type="measure"/>
                <field name="cumplimiento" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_route_compliance_graph" model="ir.ui.view">
        <field name="name">sng.route.schedule.compliance.graph</field>
        <field name="model">sng.route.schedule.compliance</field>
        <field name="arch" type="xml">
            <graph string="Cumplimiento" type="bar">
                <field name="salesperson_id"/>
                <field name="estado"/>
                <field name="programados" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_route_compliance_search" model="ir.ui.view">
        <field name="name">sng.route.schedule.compliance.search</field>
        <field name="model">sng.route.schedule.compliance</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="route_id"/>
                <field name="schedule_id"/>
                <filter name="visitado" string="Visitados" domain="[('estado', '=', 'visitado')]"/>
                <filter name="no_visitado" string="No visitados" domain="[('estado', '=', 'no_visitado')]"/>
                <filter name="pendiente" string="Pendientes" domain="[('estado', '=', 'pendiente')]"/>
                <filter name="cerrado" string="Cerrados por temporada" domain="[('estado', '=', 'cerrado')]"/>
                <separator/>
                <filter name="semana_actual" string="Semana actual"
                        domain="[('week_start', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 ('week_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week_start" string="Semana" date="week_start"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_salesperson" string="Asesor" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_route" string="Ruta" context="{'group_by': 'route_id'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'week_start:week'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                    <filter name="group_motivo" string="Motivo" context="{'group_by': 'motivo_sin_venta_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_route_schedule_compliance" model="ir.actions.act_window">
        <field name="name">Cumplimiento de visitas</field>
        <field name="res_model">sng.route.schedule.compliance</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="search_view_id" ref="view_route_compliance_search"/>
    </record>
</odoo>
