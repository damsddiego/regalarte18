<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sng_replenishment" model="ir.module.category">
        <field name="name">Reabastecimiento SNG</field>
        <field name="description">Planificación y control del reabastecimiento entre almacenes.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_replenishment_planner" model="res.groups">
        <field name="name">Planificador de reabastecimiento</field>
        <field name="category_id" ref="module_category_sng_replenishment"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_replenishment_manager" model="res.groups">
        <field name="name">Responsable de reabastecimiento</field>
        <field name="category_id" ref="module_category_sng_replenishment"/>
        <field name="implied_ids" eval="[(4, ref('group_replenishment_planner')), (4, ref('stock.group_stock_manager'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_replenishment_config_company" model="ir.rule">
            <field name="name">Reabastecimiento: configuración por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_replenishment_source_company" model="ir.rule">
            <field name="name">Reabastecimiento: CEDIS por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_source"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_replenishment_batch_company" model="ir.rule">
            <field name="name">Reabastecimiento: ciclos por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_replenishment_line_company" model="ir.rule">
            <field name="name">Reabastecimiento: líneas por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_replenishment_allocation_company" model="ir.rule">
            <field name="name">Reabastecimiento: asignaciones por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_replenishment_alert_company" model="ir.rule">
            <field name="name">Reabastecimiento: alertas por compañía</field>
            <field name="model_id" ref="model_sng_biweekly_replenishment_alert"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>

