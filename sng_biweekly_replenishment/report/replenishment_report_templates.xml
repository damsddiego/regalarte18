<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_replenishment_batch_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Reabastecimiento bisemanal <span t-field="o.name"/></h2>
                <div class="row mb-3">
                    <div class="col-4"><strong>Bodega Principal:</strong> <span t-field="o.main_warehouse_id"/></div>
                    <div class="col-4"><strong>Fecha:</strong> <span t-field="o.run_date"/></div>
                    <div class="col-4"><strong>Estado:</strong> <span t-field="o.state"/></div>
                    <div class="col-6"><strong>Inicio demanda:</strong> <span t-field="o.period_start"/></div>
                    <div class="col-6"><strong>Fin demanda:</strong> <span t-field="o.period_end"/></div>
                </div>

                <t t-foreach="o.config_id.source_line_ids.sorted(lambda s: (s.sequence, s.id))" t-as="source">
                    <t t-set="source_allocations" t-value="o.allocation_ids.filtered(lambda a: a.source_id == source)"/>
                    <t t-if="source_allocations">
                        <h3 class="mt-3">
                            CEDIS: <span t-field="source.warehouse_id"/>
                            <small t-if="source_allocations.picking_id" class="text-muted">
                                — <span t-esc="', '.join(source_allocations.mapped('picking_id.name'))"/>
                            </small>
                        </h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th class="text-end">Salidas 14 días</th>
                                    <th class="text-end">Stock proyectado</th>
                                    <th class="text-end">Sugerido</th>
                                    <th class="text-end">Asignado CEDIS</th>
                                    <th>Unidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="source_allocations" t-as="allocation">
                                    <td><span t-field="allocation.line_id.product_code"/></td>
                                    <td><span t-field="allocation.product_id"/></td>
                                    <td class="text-end"><span t-field="allocation.line_id.demand_qty"/></td>
                                    <td class="text-end"><span t-field="allocation.line_id.projected_qty"/></td>
                                    <td class="text-end"><span t-field="allocation.line_id.suggested_qty"/></td>
                                    <td class="text-end"><span t-field="allocation.allocated_qty"/></td>
                                    <td><span t-field="allocation.uom_id"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <t t-set="shortage_lines" t-value="o.line_ids.filtered(lambda line: line.shortage_qty &gt; 0)"/>
                <t t-if="shortage_lines">
                    <h3 class="mt-4 text-danger">Cantidades no abastecidas</h3>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th class="text-end">Sugerido</th>
                                <th class="text-end">Asignado</th>
                                <th class="text-end">Faltante</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="shortage_lines" t-as="line">
                                <td><span t-field="line.product_code"/></td>
                                <td><span t-field="line.product_id"/></td>
                                <td class="text-end"><span t-field="line.suggested_qty"/></td>
                                <td class="text-end"><span t-field="line.allocated_qty"/></td>
                                <td class="text-end"><strong><span t-field="line.shortage_qty"/></strong></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <template id="report_replenishment_batch">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sng_biweekly_replenishment.report_replenishment_batch_document"/>
            </t>
        </t>
    </template>
</odoo>

