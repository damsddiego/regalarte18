<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_replenishment" model="ir.ui.view">
        <field name="name">stock.picking.form.replenishment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_replenishment_batch" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not sng_replenishment_batch_id"
                        groups="sng_biweekly_replenishment.group_replenishment_planner">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Ciclo</span>
                        <field name="sng_replenishment_batch_id" class="o_stat_value"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sng_replenishment_batch_id" readonly="1"
                       invisible="not sng_replenishment_batch_id"
                       groups="sng_biweekly_replenishment.group_replenishment_planner"/>
                <field name="sng_replenishment_source_id" readonly="1"
                       invisible="not sng_replenishment_source_id"
                       groups="sng_biweekly_replenishment.group_replenishment_planner"/>
            </xpath>
        </field>
    </record>
</odoo>

