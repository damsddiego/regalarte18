<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_card_settlement" model="ir.ui.view">
        <field name="name">account.payment.form.card.settlement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_card_settlement_required" invisible="1"/>
                <field name="card_settlement_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box'][hasclass('oe_button_box')]" position="inside">
                <button name="action_open_card_settlement"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="not card_settlement_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Liquidación</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="Liquidación de tarjeta" invisible="not is_card_settlement_required and not card_settlement_id">
                    <field name="is_card_settlement_required" readonly="1"/>
                    <field name="card_settlement_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_card_settlement" model="ir.ui.view">
        <field name="name">account.payment.list.card.settlement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="card_settlement_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_card_settlement" model="ir.ui.view">
        <field name="name">account.payment.search.card.settlement</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='reconciled']" position="after">
                <filter string="Tarjeta pendiente"
                        name="pending_card_settlement"
                        domain="[('is_card_settlement_required', '=', True), ('card_settlement_id', '=', False)]"/>
                <filter string="Tarjeta liquidada"
                        name="done_card_settlement"
                        domain="[('card_settlement_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
