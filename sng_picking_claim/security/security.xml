<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_picking_claim_user" model="res.groups">
            <field name="name">Usuario de alistado móvil</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_picking_claim_manager" model="res.groups">
            <field name="name">Responsable de alistado móvil</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids"
                   eval="[(4, ref('sng_picking_claim.group_picking_claim_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_picking_claim_company" model="ir.rule">
            <field name="name">Reclamos de alistado por compañía</field>
            <field name="model_id" ref="model_sng_picking_claim"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups"
                   eval="[(4, ref('sng_picking_claim.group_picking_claim_user'))]"/>
        </record>

        <record id="rule_picking_device_company" model="ir.rule">
            <field name="name">Dispositivos de alistado por compañía</field>
            <field name="model_id" ref="model_sng_picking_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups"
                   eval="[(4, ref('sng_picking_claim.group_picking_claim_user'))]"/>
        </record>
    </data>
</odoo>
