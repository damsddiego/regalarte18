<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sng_sales_route" model="ir.actions.act_window">
        <field name="name">Rutas / Territorios</field>
        <field name="res_model">sng.sales.route</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p>Administra las rutas o territorios comerciales usados para clasificar clientes y documentos.</p>
        </field>
    </record>

    <menuitem id="menu_sng_sales_route"
              name="Rutas / Territorios"
              parent="contacts.menu_contacts"
              action="action_sng_sales_route"
              sequence="135"/>

    <record id="view_sng_sales_route_list" model="ir.ui.view">
        <field name="name">sng.sales.route.list</field>
        <field name="model">sng.sales.route</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="salesperson_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sng_sales_route_form" model="ir.ui.view">
        <field name="name">sng.sales.route.form</field>
        <field name="model">sng.sales.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sng_sales_route_search" model="ir.ui.view">
        <field name="name">sng.sales.route.search</field>
        <field name="model">sng.sales.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="salesperson_id"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vendedor de referencia" name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Compañía" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
