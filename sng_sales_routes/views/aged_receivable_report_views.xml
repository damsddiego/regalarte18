<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aged_receivable_report_unique_id" model="account.report.column">
        <field name="name">Código cliente</field>
        <field name="expression_label">unique_id</field>
        <field name="figure_type">string</field>
        <field name="sequence">-30</field>
        <field name="report_id" ref="account_reports.aged_receivable_report"/>
    </record>

    <record id="aged_receivable_report_sales_route" model="account.report.column">
        <field name="name">Ruta</field>
        <field name="expression_label">sales_route</field>
        <field name="figure_type">string</field>
        <field name="sequence">-20</field>
        <field name="report_id" ref="account_reports.aged_receivable_report"/>
    </record>

    <record id="aged_receivable_report_salesperson_name" model="account.report.column">
        <field name="name">Vendedor</field>
        <field name="expression_label">salesperson_name</field>
        <field name="figure_type">string</field>
        <field name="sequence">-10</field>
        <field name="report_id" ref="account_reports.aged_receivable_report"/>
    </record>

    <record id="aged_receivable_line_unique_id" model="account.report.expression">
        <field name="label">unique_id</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_aged_receivable</field>
        <field name="subformula">unique_id</field>
        <field name="figure_type">string</field>
        <field name="auditable" eval="False"/>
        <field name="report_line_id" ref="account_reports.aged_receivable_line"/>
    </record>

    <record id="aged_receivable_line_sales_route" model="account.report.expression">
        <field name="label">sales_route</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_aged_receivable</field>
        <field name="subformula">sales_route</field>
        <field name="figure_type">string</field>
        <field name="auditable" eval="False"/>
        <field name="report_line_id" ref="account_reports.aged_receivable_line"/>
    </record>

    <record id="aged_receivable_line_salesperson_name" model="account.report.expression">
        <field name="label">salesperson_name</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_aged_receivable</field>
        <field name="subformula">salesperson_name</field>
        <field name="figure_type">string</field>
        <field name="auditable" eval="False"/>
        <field name="report_line_id" ref="account_reports.aged_receivable_line"/>
    </record>
</odoo>
