<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_valuation_watchdog" model="ir.cron">
            <field name="name">SNG: Vigilante de valoración de inventario</field>
            <field name="model_id" ref="model_sng_valuation_watchdog"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_checks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 11:00 UTC = 05:00 Costa Rica -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="param_watchdog_emails" model="ir.config_parameter">
            <field name="key">sng_valuation_watchdog.email_to</field>
            <field name="value">diego@sngstore.com</field>
        </record>
        <record id="param_watchdog_ratio" model="ir.config_parameter">
            <field name="key">sng_valuation_watchdog.cost_price_ratio</field>
            <field name="value">0.8</field>
        </record>
        <record id="param_watchdog_max_rows" model="ir.config_parameter">
            <field name="key">sng_valuation_watchdog.max_rows</field>
            <field name="value">25</field>
        </record>
    </data>
</odoo>
