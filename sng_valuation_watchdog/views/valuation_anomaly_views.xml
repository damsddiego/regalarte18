<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_anomaly_list" model="ir.ui.view">
        <field name="name">sng.valuation.anomaly.list</field>
        <field name="model">sng.valuation.anomaly</field>
        <field name="arch" type="xml">
            <list string="Anomalías de valoración" create="false" edit="false" delete="false">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar ahora"
                            class="btn-primary" display="always"/>
                </header>
                <field name="anomaly_type"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="qty_fisica" optional="show"/>
                <field name="qty_valorada" optional="show"/>
                <field name="diferencia" optional="hide"/>
                <field name="costo" optional="show"/>
                <field name="precio_venta" optional="show"/>
                <field name="margen_pct" optional="show"/>
                <field name="valor" optional="hide"/>
                <field name="first_seen"/>
                <field name="dias"/>
                <field name="last_refresh" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_valuation_anomaly_form" model="ir.ui.view">
        <field name="name">sng.valuation.anomaly.form</field>
        <field name="model">sng.valuation.anomaly</field>
        <field name="arch" type="xml">
            <form string="Anomalía de valoración" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="anomaly_type"/>
                            <field name="product_id"/>
                            <field name="default_code"/>
                            <field name="categ_id"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="reference" invisible="not reference"/>
                        </group>
                        <group>
                            <field name="qty_fisica"/>
                            <field name="qty_valorada"/>
                            <field name="diferencia"/>
                            <field name="costo"/>
                            <field name="precio_venta"/>
                            <field name="margen_pct"/>
                            <field name="valor"/>
                        </group>
                        <group>
                            <field name="first_seen"/>
                            <field name="dias"/>
                            <field name="last_refresh"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_valuation_anomaly_search" model="ir.ui.view">
        <field name="name">sng.valuation.anomaly.search</field>
        <field name="model">sng.valuation.anomaly</field>
        <field name="arch" type="xml">
            <search string="Anomalías de valoración">
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <filter name="f_descuadre" string="Físico ≠ valorado" domain="[('anomaly_type', '=', 'descuadre')]"/>
                <filter name="f_entrada" string="Entrada a precio de venta" domain="[('anomaly_type', '=', 'entrada_precio_venta')]"/>
                <filter name="f_margen" string="Margen anómalo" domain="[('anomaly_type', '=', 'margen')]"/>
                <filter name="f_costo_cero" string="Costo en 0" domain="[('anomaly_type', '=', 'costo_cero')]"/>
                <filter name="f_svl_negativa" string="Valorado negativo" domain="[('anomaly_type', '=', 'svl_negativa')]"/>
                <separator/>
                <filter name="f_mas_7_dias" string="Más de 7 días sin corregir"
                        domain="[('first_seen', '&lt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_type" string="Problema" context="{'group_by': 'anomaly_type'}"/>
                    <filter name="group_categ" string="Categoría" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_valuation_anomaly" model="ir.actions.act_window">
        <field name="name">Anomalías de valoración</field>
        <field name="res_model">sng.valuation.anomaly</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin anomalías de valoración</p>
            <p>La lista se actualiza todos los días con el vigilante de valoración.
               Use "Actualizar ahora" para revisarla en este momento.</p>
        </field>
    </record>

    <menuitem id="menu_valuation_anomaly"
              name="Anomalías de valoración"
              parent="stock.menu_warehouse_report"
              action="action_valuation_anomaly"
              groups="stock.group_stock_manager"
              sequence="120"/>
</odoo>
