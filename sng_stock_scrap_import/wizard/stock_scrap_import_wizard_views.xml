<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sng_stock_scrap_import_wizard_form" model="ir.ui.view">
        <field name="name">sng.stock.scrap.import.wizard.form</field>
        <field name="model">sng.stock.scrap.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar desecho desde Excel">
                <group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                        <field name="origin"/>
                        <field name="validate_scraps"/>
                    </group>
                    <group>
                        <field name="location_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="scrap_location_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>

                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>Formato esperado:</strong>
                        <ul>
                            <li>Columna A: Codigo</li>
                            <li>Columna B: Descripcion</li>
                            <li>Columna C: Danado</li>
                        </ul>
                        <p>El importador agrupa lineas repetidas por codigo, busca productos por referencia interna y valida stock disponible en la ubicacion origen.</p>
                        <p>Si un producto usa lote o serie, la importacion se detiene porque este archivo no trae ese detalle.</p>
                    </div>
                </group>

                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_stock_scrap_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar desecho</field>
        <field name="res_model">sng.stock.scrap.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_sng_stock_scrap_import_wizard"
        name="Importar desecho"
        parent="stock.menu_stock_adjustments"
        action="action_sng_stock_scrap_import_wizard"
        sequence="98"
        groups="stock.group_stock_user"/>

</odoo>
