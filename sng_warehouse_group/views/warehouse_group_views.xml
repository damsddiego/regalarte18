<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_warehouse_group_list" model="ir.ui.view">
        <field name="name">sng.warehouse.group.list</field>
        <field name="model">sng.warehouse.group</field>
        <field name="arch" type="xml">
            <list string="Grupos de Almacenes" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="warehouse_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sng_warehouse_group_form" model="ir.ui.view">
        <field name="name">sng.warehouse.group.form</field>
        <field name="model">sng.warehouse.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de Almacenes">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <label for="name"/>
                    <h1>
                        <field name="name" placeholder="Ej. Almacenes principales"/>
                    </h1>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="sequence"/>
                    </group>
                    <group string="Almacenes">
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" placeholder="Uso previsto del grupo..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sng_warehouse_group_search" model="ir.ui.view">
        <field name="name">sng.warehouse.group.search</field>
        <field name="model">sng.warehouse.group</field>
        <field name="arch" type="xml">
            <search string="Grupos de Almacenes">
                <field name="name"/>
                <field name="warehouse_ids"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sng_warehouse_group" model="ir.actions.act_window">
        <field name="name">Grupos de Almacenes</field>
        <field name="res_model">sng.warehouse.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sng_warehouse_group_search"/>
    </record>

    <menuitem
        id="menu_sng_warehouse_group"
        name="Grupos de Almacenes"
        parent="stock.menu_warehouse_config"
        action="action_sng_warehouse_group"
        sequence="2"
        groups="stock.group_stock_manager"
    />
</odoo>
