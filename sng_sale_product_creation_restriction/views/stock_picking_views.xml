<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        La misma vista de stock.picking se utiliza para recepciones, entregas y
        traslados internos. El usuario conserva la posibilidad de seleccionar
        cualquier producto existente.
    -->
    <record id="view_picking_form_disable_product_creation" model="ir.ui.view">
        <field name="name">stock.picking.form.disable.product.creation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="attributes">
                <attribute name="options">{
                    'no_create': True,
                    'no_create_edit': True,
                    'no_quick_create': True,
                }</attribute>
            </xpath>
        </field>
    </record>

    <!-- Formulario emergente que se abre al editar el detalle del movimiento. -->
    <record id="view_stock_move_operations_disable_product_creation" model="ir.ui.view">
        <field name="name">stock.move.operations.form.disable.product.creation</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="options">{
                    'no_create': True,
                    'no_create_edit': True,
                    'no_quick_create': True,
                }</attribute>
            </xpath>
        </field>
    </record>
</odoo>
