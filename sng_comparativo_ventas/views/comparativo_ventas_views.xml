<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Tree view del reporte
    ================================================================ -->
    <record id="view_sng_comparativo_line_list" model="ir.ui.view">
        <field name="name">sng.comparativo.line.list</field>
        <field name="model">sng.comparativo.line</field>
        <field name="arch" type="xml">
            <list string="Comparativo de Ventas"
                  decoration-danger="meses_inventario &gt; 12"
                  decoration-warning="total_6m == 0 and inv_actual &gt; 0"
                  decoration-success="meses_inventario &gt; 0 and meses_inventario &lt;= 3"
                  create="false" delete="false" import="false">
                <field name="codigo" optional="show" string="Código"/>
                <field name="descripcion" string="Descripción"/>
                <field name="costo" string="Costo" optional="show" groups="custom_ui_security.group_view_product_cost"/>
                <field name="precio" string="Precio" optional="show"/>
                <field name="mes_6"  string="Hace 6m" sum="Total"/>
                <field name="mes_5"  string="Hace 5m" sum="Total"/>
                <field name="mes_4"  string="Hace 4m" sum="Total"/>
                <field name="mes_3"  string="Hace 3m" sum="Total"/>
                <field name="mes_2"  string="Hace 2m" sum="Total"/>
                <field name="mes_1"  string="Hace 1m" sum="Total"/>
                <field name="total_6m"          string="Total 6m"   sum="Total"/>
                <field name="promedio_mensual"   string="Prom/mes"   avg="Prom"/>
                <field name="inv_actual"         string="Inv. Actual" sum="Total"/>
                <field name="meses_inventario"   string="Meses Inv." avg="Prom"/>
                <field name="proveedor"          string="Proveedor"  optional="show"/>
                <field name="product_id"         string="Producto"   optional="hide"/>
                <field name="company_currency_id" optional="hide" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_sng_comparativo_line_search" model="ir.ui.view">
        <field name="name">sng.comparativo.line.search</field>
        <field name="model">sng.comparativo.line</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="descripcion" string="Producto"/>
                <field name="codigo"      string="Código"/>
                <field name="proveedor"   string="Proveedor"/>
                <separator/>
                <filter string="Con ventas"
                        name="con_ventas"
                        domain="[('total_6m', '&gt;', 0)]"/>
                <filter string="Sin ventas (con inventario)"
                        name="muertos"
                        domain="[('total_6m', '=', 0), ('inv_actual', '&gt;', 0)]"/>
                <filter string="Sobrestock (&gt;12 meses)"
                        name="sobrestock"
                        domain="[('meses_inventario', '&gt;', 12)]"/>
                <filter string="Stock bajo (≤3 meses)"
                        name="stock_bajo"
                        domain="[('meses_inventario', '&gt;', 0), ('meses_inventario', '&lt;=', 3)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Proveedor"
                            name="group_by_proveedor"
                            context="{'group_by': 'proveedor'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action para abrir el resultado del reporte -->
    <record id="action_sng_comparativo_line" model="ir.actions.act_window">
        <field name="name">Comparativo de Ventas</field>
        <field name="res_model">sng.comparativo.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sng_comparativo_line_list"/>
        <field name="search_view_id" ref="view_sng_comparativo_line_search"/>
    </record>

    <!-- ================================================================
         Menús
    ================================================================ -->
    <!-- Ventas > Reportes > Comparativo de Ventas -->
    <menuitem id="menu_sng_comparativo_ventas_sale"
              name="Comparativo de Ventas"
              parent="sale.menu_sale_report"
              action="action_sng_comparativo_wizard"
              sequence="50"/>

    <!-- Inventario > Reportes > Comparativo de Ventas -->
    <menuitem id="menu_sng_comparativo_ventas_stock"
              name="Comparativo de Ventas"
              parent="stock.menu_warehouse_report"
              action="action_sng_comparativo_wizard"
              sequence="50"/>

</odoo>
