<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consolidated_customer_payment_bridge_list" model="ir.ui.view">
        <field name="name">consolidated.customer.payment.bridge.list</field>
        <field name="model">consolidated.customer.payment.bridge</field>
        <field name="arch" type="xml">
            <list string="Puentes intercompany">
                <field name="company_id"/>
                <field name="counterpart_company_id"/>
                <field name="journal_id"/>
                <field name="bridge_account_id"/>
                <field name="active"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_consolidated_customer_payment_bridge_form" model="ir.ui.view">
        <field name="name">consolidated.customer.payment.bridge.form</field>
        <field name="model">consolidated.customer.payment.bridge</field>
        <field name="arch" type="xml">
            <form string="Puente intercompany">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="counterpart_company_id"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="bridge_account_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_consolidated_customer_payment_bridge" model="ir.actions.act_window">
        <field name="name">Intercompany Bridges</field>
        <field name="res_model">consolidated.customer.payment.bridge</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_consolidated_customer_payment_bridge"
        name="Consolidated Payment Bridges"
        parent="account.menu_finance_configuration"
        action="action_consolidated_customer_payment_bridge"
        groups="account.group_account_manager"
        sequence="60"/>
</odoo>
