<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_consolidated_payment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.consolidated.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[@id='invoicing_settings']" position="after">
                <block title="Consolidated Customer Payments" name="consolidated_customer_payments">
                    <setting string="Auto reconcile consolidated allocations"
                        company_dependent="1"
                        help="Automatically reconcile destination entries against the selected invoices within each company.">
                        <field name="consolidated_payment_auto_reconcile"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
