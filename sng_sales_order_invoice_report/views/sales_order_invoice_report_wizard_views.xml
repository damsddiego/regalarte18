<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_sales_order_invoice_report_wizard_form" model="ir.ui.view">
        <field name="name">sng.sales.order.invoice.report.wizard.form</field>
        <field name="model">sng.sales.order.invoice.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Ventas Ingresadas vs Facturadas">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="salesperson_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_open_report" type="object" string="Consultar" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Exportar Excel" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_sales_order_invoice_report_wizard" model="ir.actions.act_window">
        <field name="name">Ventas Ingresadas vs Facturadas</field>
        <field name="res_model">sng.sales.order.invoice.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sng_sales_order_invoice_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
