<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_inventory_adjustment_approver" model="res.groups">
        <field name="name">Gerencia: aprobar y aplicar ajustes de inventario</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('custom_ui_security.group_view_product_cost'))]"/>
        <field name="comment">Puede revisar solicitudes, aprobar, rechazar y aplicar ajustes manuales. No se asigna automáticamente a los administradores de Inventario.</field>
    </record>
    <record id="adjustment_request_company_rule" model="ir.rule">
        <field name="name">Solicitudes de ajuste: compañías permitidas</field>
        <field name="model_id" ref="model_sng_inventory_adjustment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="adjustment_request_operator_rule" model="ir.rule">
        <field name="name">Solicitudes de ajuste: propias</field>
        <field name="model_id" ref="model_sng_inventory_adjustment_request"/>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
    </record>
    <record id="adjustment_request_approver_rule" model="ir.rule">
        <field name="name">Solicitudes de ajuste: Gerencia</field>
        <field name="model_id" ref="model_sng_inventory_adjustment_request"/>
        <field name="groups" eval="[(4, ref('group_inventory_adjustment_approver'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
